@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="modal-backdrop fade show"></div>

<div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Import dat</h5>
                <button type="button" class="btn-close" disabled="@isUploading" @onclick="OnClose" />
            </div>

            <div class="modal-body">
                <label class="form-label">Typ dat</label>
                <select class="form-select mb-3"
                        @bind="selectedType"
                        disabled="@isUploading">
                    <option value="gps">GPS (GPX)</option>
                    <option value="bts">BTS (CSV)</option>
                </select>

                <label class="form-label">Soubor</label>
                <InputFile class="form-control" OnChange="FileSelected" disabled="@isUploading" />

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-3">@errorMessage</div>
                }

                @if (isUploading)
                {
                    <div class="mt-3">
                        <div class="spinner-border spinner-border-sm" />
                        Importování...
                    </div>
                }

            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" disabled="@(selectedFile == null || isUploading)" @onclick="UploadAsync">Importovat</button>
                <button class="btn btn-secondary" disabled="@isUploading" @onclick="OnClose">Zrušit</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnImported { get; set; }

    private IBrowserFile? selectedFile;
	private string selectedType = "gps"; // default to GPS
    private string? errorMessage;
    private bool isUploading;

    private void FileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = null;
    }

    private async Task UploadAsync()
    {
        if (selectedFile == null || isUploading)
            return;

        isUploading = true;
        errorMessage = null;

        try
        {
			const long maxFileSize = 20 * 1024 * 1024; //20MB same as in the backend (ImportEndpoint.cs)
            using var content = new MultipartFormDataContent();
            using var fileContent = new StreamContent(selectedFile.OpenReadStream(maxFileSize));

            content.Add(fileContent, "file", selectedFile.Name);
            var requestUri = new Uri(new Uri(Navigation.BaseUri), $"api/import/{selectedType}"); //Navigation.BaseUri handles API pathing at runtime.
            var response = await Http.PostAsync(requestUri, content);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            await OnImported.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Import se nezdařil: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }
}
