@page "/map"
@using CPTestProject.Client.Component

<PageTitle>Mapa GPS/BTS</PageTitle>

<div class="container-fluid p-3">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Mapa GPS/BTS</h4>

        <div class="d-flex gap-2">
            <div class="dropdown">
                <button class="btn btn-outline-primary dropdown-toggle" @onclick="ToggleSystemMenu">Systém</button>

                @if (showSystemMenu)
                {
                    <ul class="dropdown-menu show">
                        <li>
                            <button class="dropdown-item" @onclick="OpenImport">Import</button>
                        </li>
                    </ul>
                }
            </div>

            <button class="btn btn-outline-secondary">Nastavení</button>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label>
                <input type="checkbox" @bind="showGps" />GPS trasa</label>
        </div>

        <div class="col-md-6">
            <label>
                <input type="checkbox" @bind="showBts" />BTS měření</label>
        </div>
    </div>

    <!-- Map placeholder -->
    <div class="border rounded bg-light d-flex align-items-center justify-content-center" style="height: 500px;">
        <span class="text-muted">OSM placeholder.</span>
    </div>

    <!-- Details panel -->
    <div class="card mt-3">
        <div class="card-header">Detail BTS měření</div>

        <div class="card-body">
            <p class="text-muted mb-0">Vyberte bod BTS měření na mapě.</p>
        </div>
    </div>

</div>

@if (showImportDialog)
{
    <ImportDialog OnClose="CloseImport" OnImported="ImportCompleted" />
}

@code {
    private bool showSystemMenu;
    private bool showImportDialog;

    private bool showGps = true;
    private bool showBts = true;

    private void ToggleSystemMenu() => showSystemMenu = !showSystemMenu;

    private void OpenImport()
    {
        showSystemMenu = false;
        showImportDialog = true;
    }

    private void CloseImport() => showImportDialog = false;

    private Task ImportCompleted()
    {
        showImportDialog = false;

        // TODO: refresh imported session dropdowns.
        return Task.CompletedTask;
    }
}